<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WebKit JIT for the webview -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- The sidecars are third-party builds carrying their own (or an ad-hoc) signature, not this
       app's. Needed once hardenedRuntime is turned on for a notarized build; harmless before. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Deepgram and Anthropic API calls from the Rust backend -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
