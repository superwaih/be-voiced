# ---- Transcription on this server -------------------------------------------------------------
# The normal path: whisper.cpp runs here and the browser uploads to it. Needs three things — the
# whisper-cli binary, ffmpeg, and a model file. The Dockerfile sets all three up; for a local
# checkout, point these at your own.
#
# Looked for in order: these variables, then ./bin and ./models, then PATH.

# WHISPER_PATH=/usr/local/bin/whisper-cli
# FFMPEG_PATH=/usr/bin/ffmpeg

# Which model to load, from ./models. ggml-base.en.bin is quick; ggml-small.en-tdrz.bin is slower,
# more accurate, and the only one that marks where the speaker changes.
# WHISPER_MODEL=ggml-base.en.bin
# WHISPER_MODEL_PATH=/app/models/ggml-base.en.bin

# Threads whisper may use. Defaults to 4; the container sets it to the core count less one.
# WHISPER_THREADS=4

# ---- Pasted links -----------------------------------------------------------------------------
# Direct media links and podcast feeds need nothing. Everything else needs yt-dlp.
# YTDLP_PATH=/usr/bin/yt-dlp

# ---- Optional stand-in ------------------------------------------------------------------------
# Used only when whisper is not installed on this server. Leave unset to run on whisper alone;
# with neither, the browser transcribes instead and the app says so.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# ---- Backups ----------------------------------------------------------------------------------
# pg_dump runs daily in its own container and uploads off the box. Nothing runs until
# BACKUP_S3_ENDPOINT is set — the service starts, says it is not configured, and stops.
#
# This must NOT be this machine's own MinIO. A dump on the disk it exists to survive is not a
# backup, and the script refuses that endpoint rather than succeeding into it.
#
# Cloudflare R2 is the sensible target: free egress, so pulling a dump back during an incident
# costs nothing. Any S3-compatible storage works.
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=bevoiced-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# Daily time in UTC, always UTC — a local-time schedule runs twice or not at all on the days the
# clocks change. Not on the hour, because every cron everywhere fires at 03:00.
# BACKUP_AT=03:17
# BACKUP_RETAIN_DAYS=14
# BACKUP_S3_PREFIX=postgres

# Back up once on container start, to check credentials without waiting for the clock. Off by
# default so a crash-looping container cannot hammer the bucket.
# BACKUP_ON_START=false
