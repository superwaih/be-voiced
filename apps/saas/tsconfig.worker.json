{
  // The worker is a plain Node process, not part of the Next build, so it is compiled on its own:
  // `output: "standalone"` bundles only the web server.
  //
  // CommonJS, so the relative imports in src/server need no rewriting. The build drops a
  // `dist/package.json` saying so, because this package is otherwise ESM.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "sourceMap": true,
    "incremental": false,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts"],
  "exclude": ["node_modules"]
}
