{
  "name": "@be-voiced/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sidecars": "node scripts/sidecars.mjs",
    "app:dev": "tauri dev",
    "app:dev:no-whisper": "tauri dev --config src-tauri/tauri.nowhisper.json",
    "app:dev:ui": "tauri dev --config src-tauri/tauri.nosidecars.json",
    "app:build": "tauri build",
    "app:build:mac-universal": "node scripts/sidecars.mjs --target universal-apple-darwin && tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@be-voiced/engine": "workspace:*",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "motion": "^13.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
